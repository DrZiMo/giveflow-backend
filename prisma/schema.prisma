generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  USER
  ADMIN
}

enum CAUSE_STATUS {
  VERIFIED
  PENDING
  REJECTED
}

enum URGENCY_LEVEL {
  HIGH
  MEDIUM
  LOW
}

model user {
  id                       Int                 @id @default(autoincrement())
  first_name               String
  last_name                String
  email                    String              @unique
  phone_number             String
  password                 String
  profile_pic              String              @default("")
  profile_pic_public_id    String              @default("")
  role                     ROLE
  is_anonymous             Boolean             @default(false)
  is_verified              Boolean             @default(false)
  is_deleted               Boolean             @default(false)
  is_email_verified        Boolean             @default(false)
  is_phone_number_verified Boolean             @default(false)
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt
  cause                    cause[]
  donation                 donation[]
  following                follower[]
  notification             notification[]
  like                     like[]
  saveForLater             save_for_later[]
  review                   review[]
  reply                    reply[]
  search_history           search_history[]
  verification_code        verification_code[]
}

model giving_page {
  id                    String               @id @default(uuid())
  name                  String               @unique
  description           String
  profile_pic           String               @default("")
  profile_pic_public_id String               @default("")
  cover_pic             String               @default("")
  cover_pic_public_id   String               @default("")
  created_by_id         Int
  is_verified           Boolean              @default(false)
  is_deleted            Boolean              @default(false)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  cause                 cause[]
  follower              follower[]
  giving_page_images    giving_page_images[]
}

model giving_page_images {
  id             String   @id @default(uuid())
  giving_page_id String
  link           String
  public_id      String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  giving_page giving_page @relation(fields: [giving_page_id], references: [id], onDelete: Cascade)
}

model cause {
  id                  String        @id @default(uuid())
  giving_page_id      String
  name                String
  short_description   String?
  long_description    String?
  cause_pic           String        @default("")
  cause_pic_public_id String        @default("")
  amount_needed       Float
  current_amount      Float
  status              CAUSE_STATUS
  is_deleted          Boolean       @default(false)
  is_featured         Boolean       @default(false)
  category_id         String
  urgency_level       URGENCY_LEVEL
  is_expired          Boolean       @default(false)
  expiration_date     DateTime
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  giving_page  giving_page      @relation(fields: [giving_page_id], references: [id], onDelete: Cascade)
  category     category         @relation(fields: [category_id], references: [id], onDelete: Cascade)
  donation     donation[]
  like         like[]
  saveForLater save_for_later[]
  review       review[]
  user         user?            @relation(fields: [userId], references: [id])
  userId       Int?
  cause_image  cause_image[]
}

model cause_image {
  id         String   @id @default(uuid())
  cause_id   String
  link       String
  public_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model category {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cause      cause[]
}

model donation {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  donated_at DateTime @default(now())

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model follower {
  id             String   @id @default(uuid())
  user_id        Int
  giving_page_id String
  followed_at    DateTime @default(now())

  user        user        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  giving_page giving_page @relation(fields: [giving_page_id], references: [id], onDelete: Cascade)
}

model notification {
  id         String   @id @default(uuid())
  user_id    Int
  name       String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model like {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  liked_at   DateTime @default(now())
  updated_at DateTime @updatedAt

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model save_for_later {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  saved_at   DateTime @default(now())
  updated_at DateTime @updatedAt

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model search_history {
  id         String   @id @default(uuid())
  user_id    Int
  search     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model review {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  message    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    user    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause   cause   @relation(fields: [cause_id], references: [id], onDelete: Cascade)
  replies reply[]
}

model reply {
  id         String   @id @default(uuid())
  user_id    Int
  review_id  String
  message    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   user   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  review review @relation(fields: [review_id], references: [id], onDelete: Cascade)
}

model verification_code {
  id         String   @id @default(uuid())
  code       String
  user_id    Int
  expiry     DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
