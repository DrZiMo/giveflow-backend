generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  USER
  MODERATOR
  ADMIN
}

enum CAUSE_STATUS {
  ACTIVE
  COMPELETED
  INACTIVE
  PENDING
  REJECTED
}

enum URGENCY_LEVEL {
  HIGH
  MEDIUM
  LOW
}

model user {
  id                           Int                 @id @default(autoincrement())
  first_name                   String
  last_name                    String
  email                        String              @unique
  phone_number                 String
  password                     String
  profile_pic                  String              @default("")
  profile_pic_public_id        String              @default("")
  role                         ROLE
  is_anonymous                 Boolean             @default(false)
  is_public                    Boolean             @default(true)
  is_history_visible           Boolean             @default(true)
  is_deleted                   Boolean             @default(false)
  is_email_verified            Boolean             @default(false)
  is_phone_number_verified     Boolean             @default(false)
  is_two_factor_authentication Boolean             @default(false)
  is_logged_in                 Boolean             @default(false)
  created_at                   DateTime            @default(now())
  updated_at                   DateTime            @updatedAt
  cause                        cause[]
  donation                     donation[]
  notification                 notification[]
  like                         like[]
  saveForLater                 save_for_later[]
  verification_code            verification_code[]
  user_settings                user_settings[]
  recent_activity              recent_activity[]
}

model cause {
  id                  String        @id @default(uuid())
  user_id             Int
  name                String
  short_description   String?
  long_description    String?
  cause_pic           String        @default("")
  cause_pic_public_id String        @default("")
  amount_needed       Float
  current_amount      Float
  status              CAUSE_STATUS
  is_deleted          Boolean       @default(false)
  is_featured         Boolean       @default(false)
  is_trending         Boolean       @default(false)
  category_id         String
  urgency_level       URGENCY_LEVEL
  is_expired          Boolean       @default(false)
  expiration_date     DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  category     category         @relation(fields: [category_id], references: [id], onDelete: Cascade)
  donation     donation[]
  like         like[]
  saveForLater save_for_later[]
  user         user             @relation(fields: [user_id], references: [id])
}

model category {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cause      cause[]
}

model donation {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  amount     Float
  donated_at DateTime @default(now())

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model notification {
  id              String   @id @default(uuid())
  user_id         Int
  name            String
  message         String
  number_of_users Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model like {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  liked_at   DateTime @default(now())
  updated_at DateTime @updatedAt

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)

  @@unique([user_id, cause_id])
}

model save_for_later {
  id         String   @id @default(uuid())
  user_id    Int
  cause_id   String
  saved_at   DateTime @default(now())
  updated_at DateTime @updatedAt

  user  user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cause cause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
}

model verification_code {
  id         String   @id @default(uuid())
  code       String
  user_id    Int
  expiry     DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_settings {
  id                  String   @id @default(uuid())
  user_id             Int      @unique
  email_notifications Boolean  @default(false)
  sms_notifications   Boolean  @default(false)
  push_notifications  Boolean  @default(false)
  news_letter         Boolean  @default(false)
  donation_receipts   Boolean  @default(false)
  donation_reminders  Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model recent_activity {
  id         String   @id @default(uuid())
  name       String
  user_id    Int
  cause_id   String
  amount     String
  status     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
